# Copy this file to .env before running `docker compose up`.
# docker-compose.yml reads these via variable substitution.

# --- Postgres ---
POSTGRES_USER=resume_scanner
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=resume_scanner

# --- Auth ---
# Generate a real one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-real-random-secret

# --- LLM provider (Phase 3) ---
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
# Required if LLM_PROVIDER=openai. Leave unset to run with recommendations
# falling back to the deterministic template (see GenerateRecommendationsUseCase).
OPENAI_API_KEY=

# --- Frontend ---
# Must be reachable from the *browser*, not just from inside the Docker
# network -- e.g. http://localhost:8000 for local dev, or your real
# public API domain in production. Baked into the frontend build (see
# frontend/Dockerfile) -- changing this requires rebuilding the frontend
# image, not just restarting the container.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Observability & hardening (Phase 9) ---
# "production" makes a default JWT_SECRET_KEY a hard startup failure
# instead of a warning -- see app/api/main.py's InsecureConfigurationError.
ENVIRONMENT=development
# Comma-separated list of allowed origins, or "*" for local dev only.
# Set this to your real frontend domain(s) in production.
CORS_ALLOWED_ORIGINS=*
MAX_UPLOAD_SIZE_BYTES=10485760
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYSIS=20/minute
RATE_LIMIT_DEFAULT=120/minute
